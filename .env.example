# Copy to .env to override. All values below are the defaults used when .env is absent.
POSTGRES_DB=ledgerline
POSTGRES_USER=ledgerline
POSTGRES_PASSWORD=ledgerline_secret
POSTGRES_PORT=5432
KAFKA_PORT=9092
APP_PORT=8080
# Bootstrap admin API key (min 24 chars). Change it.
ADMIN_KEY=dev-admin-key-change-me-0123456789
